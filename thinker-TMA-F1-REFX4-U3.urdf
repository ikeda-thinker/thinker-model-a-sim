  <!--  @details  This file describes a robot model.               -->
  <!-- *********************************************************** -->
  <!-- ***************************************************************** -->
  <!--  @brief    Thinker ROS2 Description Fictive Link URDF             -->
  <!--  @author   SAIDA Takao, Thinker Inc.                              -->
  <!--  @par      Copyright:                                             -->
  <!--            2026, Thinker Inc.                                     -->
  <!--  @par      License: see LICENSE                                   -->
  <!--  @file     thinker/ros2/description/urdf/fictive_link_urdf.xacro  -->
  <!--  @version  0.0.3                                                  -->
  <!--  @date     2026/03/12                                             -->
  <!--  @details  This file describes a fictive link model.              -->
  <!-- ***************************************************************** -->
  <!-- ***************************************************************************** -->
  <!--  @brief    Thinker ROS2 Description Think Finger F1 Core URDF                 -->
  <!--  @author   SAIDA Takao, Thinker Inc.                                          -->
  <!--  @par      Copyright:                                                         -->
  <!--            2026, Thinker Inc.                                                 -->
  <!--  @par      License: see LICENSE                                               -->
  <!--  @file     thinker/ros2/description/fingers/thinker-TF1/urdf/core_urdf.xacro  -->
  <!--  @version  0.0.10                                                             -->
  <!--  @date     2026/03/19                                                         -->
  <!--  @details  This file describes a finger model.                                -->
  <!-- ***************************************************************************** -->
  <!-- ****************************************************************************** -->
  <!--  @brief    Thinker ROS2 Description Think Finger F1 Core URDF (gazebo)         -->
  <!--  @author   SAIDA Takao, Thinker Inc.                                           -->
  <!--  @par      Copyright:                                                          -->
  <!--            2026, Thinker Inc.                                                  -->
  <!--  @par      License: see LICENSE                                                -->
  <!--  @file     thinker/ros2/description/fingers/thinker-TF1/urdf/core_urdf.gazebo  -->
  <!--  @version  0.0.5                                                               -->
  <!--  @date     2026/03/12                                                          -->
  <!--  @details  This file describes a finger model for gazebo.                      -->
  <!-- ****************************************************************************** -->
  <!-- ***************************************************************************** -->
  <!--  @brief    Thinker ROS2 Description Think Finger F1 Core URDF (transmission)  -->
  <!--  @author   SAIDA Takao, Thinker Inc.                                          -->
  <!--  @par      Copyright:                                                         -->
  <!--            2026, Thinker Inc.                                                 -->
  <!--  @par      License: see LICENSE                                               -->
  <!--  @file     thinker/ros2/description/fingers/thinker-TF1/urdf/core_urdf.trans  -->
  <!--  @version  0.0.4                                                              -->
  <!--  @date     2026/03/12                                                         -->
  <!--  @details  This file describes a finger model.                                -->
  <!-- ***************************************************************************** -->
  <!-- ******************* -->
  <!-- materialize a robot -->
  <!-- ******************* -->
  <!-- ******************************** -->
  <!-- fictive links to ease definition -->
  <!-- ******************************** -->
  <!-- ******************************************** -->
  <!-- fictive link                                 -->
  <!-- to be simple, inertia model is 1g sphere,    -->
  <!-- with radius 0.016m, density 58kg/m3,         -->
  <!-- and visual model is 1cm-width box.           -->
  <!-- if principal inertia is less than 1e-7kg*m2, -->
  <!-- gazebo simulator would have ill result.      -->
  <!-- ******************************************** -->
  <link name="f2_thinker_TF1_nail_mount_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1.0e-7" ixy="0" ixz="0" iyy="1.0e-7" iyz="0" izz="1.0e-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <material name="f2_thinker_TF1_nail_mount_link_color">
        <color rgba="0.1 0.1 0.9 1.0"/>
      </material>
    </visual>
  </link>
  <!-- ************** -->
  <!-- links of robot -->
  <!-- ************** -->
  <link name="f2_thinker_TF1_base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 -0.01 0.064"/>
      <mass value="0.285"/>
      <inertia ixx="1.5e-4" ixy="0" ixz="0" iyy="1.1e-4" iyz="0" izz="0.86e-4"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://thinker_ros2_description/fingers/thinker-TF1/meshes/visual/base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://thinker_ros2_description/fingers/thinker-TF1/meshes/collision/base.dae"/>
      </geometry>
    </collision>
  </link>
  <link name="f2_thinker_TF1_x_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="2e-7" ixy="0" ixz="0" iyy="2e-7" iyz="0" izz="1e-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://thinker_ros2_description/fingers/thinker-TF1/meshes/visual/x.dae"/>
      </geometry>
    </visual>
  </link>
  <link name="f2_thinker_TF1_y_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="2e-7" ixy="0" ixz="0" iyy="2e-7" iyz="0" izz="1e-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://thinker_ros2_description/fingers/thinker-TF1/meshes/visual/y.dae"/>
      </geometry>
    </visual>
  </link>
  <link name="f2_thinker_TF1_z_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.0096"/>
      <mass value="0.03"/>
      <inertia ixx="1.8e-6" ixy="0" ixz="0" iyy="1.8e-6" iyz="0" izz="6e-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://thinker_ros2_description/fingers/thinker-TF1/meshes/visual/z.dae"/>
      </geometry>
    </visual>
  </link>
  <!-- ***************** -->
  <!-- fixed link offset -->
  <!-- ***************** -->
  <joint name="f2_thinker_TF1_base_joint" type="fixed">
    <parent link="robotiq_hande_right_finger"/>
    <child link="f2_thinker_TF1_base_link"/>
    <origin rpy="0 0 3.141592653589793" xyz="-0.018 0 0.0011"/>
  </joint>
  <joint name="f2_thinker_TF1_nail_mount_joint" type="fixed">
    <parent link="f2_thinker_TF1_z_link"/>
    <child link="f2_thinker_TF1_nail_mount_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.0276"/>
  </joint>
  <!-- *************** -->
  <!-- joints of robot -->
  <!-- *************** -->
  <joint name="f2_thinker_TF1_x_joint" type="revolute">
    <parent link="f2_thinker_TF1_base_link"/>
    <child link="f2_thinker_TF1_x_link"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="0 0 0.0373"/>
    <axis xyz="0 0 1"/>
    <limit effort="20.0" lower="-0.17453292519943295" upper="0.17453292519943295" velocity="2.00"/>
    <!-- safety_controller narrows range to control with joint_state_publisher -->
    <!-- safety_controller soft_lower_limit="${-PI/180*(x_stroke - 0.5)}" soft_upper_limit="${PI/180*(x_stroke - 0.5)}"
		                   k_position="22.9" k_velocity="800" / -->
    <dynamics damping="0.001"/>
  </joint>
  <joint name="f2_thinker_TF1_y_joint" type="revolute">
    <parent link="f2_thinker_TF1_x_link"/>
    <child link="f2_thinker_TF1_y_link"/>
    <origin rpy="0 1.5707963267948966 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="20.0" lower="-0.17453292519943295" upper="0.17453292519943295" velocity="6.28"/>
    <!-- safety_controller narrows range to control with joint_state_publisher -->
    <!-- safety_controller soft_lower_limit="${-PI/180*(y_stroke - 0.5)}" soft_upper_limit="${PI/180*(y_stroke - 0.5)}"
		                   k_position="72.0" k_velocity="800" / -->
    <dynamics damping="0.001"/>
  </joint>
  <joint name="f2_thinker_TF1_z_joint" type="prismatic">
    <parent link="f2_thinker_TF1_y_link"/>
    <child link="f2_thinker_TF1_z_link"/>
    <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="0.0" upper="0.005" velocity="10.0"/>
    <!-- safety_controller narrows range to control with joint_state_publisher -->
    <!-- safety_controller soft_lower_limit="0.0002" soft_upper_limit="${z_stroke - 0.0002}"
		                   k_position="100.0" k_velocity="1000" / -->
    <dynamics damping="0.001"/>
  </joint>
  <!-- ********************** -->
  <!-- transmissions of robot -->
  <!-- ********************** -->
  <transmission name="f2_thinker_TF1_x_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="f2_thinker_TF1_x_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="f2_thinker_TF1_x_motor">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>hardware_interface/EffortActuatorInterface</hardwareInterface>
    </actuator>
  </transmission>
  <transmission name="f2_thinker_TF1_y_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="f2_thinker_TF1_y_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="f2_thinker_TF1_y_motor">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>hardware_interface/EffortActuatorInterface</hardwareInterface>
    </actuator>
  </transmission>
  <transmission name="f2_thinker_TF1_z_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="f2_thinker_TF1_z_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="f2_thinker_TF1_z_motor">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>hardware_interface/EffortActuatorInterface</hardwareInterface>
    </actuator>
  </transmission>
  <!-- *************************** -->
  <!-- gazebo parameters for robot -->
  <!-- *************************** -->
  <gazebo reference="f2_thinker_TF1_base_link">
    <mu1>1</mu1>
    <mu2>1</mu2>
    <kp>1e+6</kp>
    <kd>1</kd>
    <maxContacts>20</maxContacts>
  </gazebo>
  <!-- *************************** -->
  <!-- gazebo ROS interface plugin -->
  <!-- *************************** -->
  <!-- gazebo -->
  <!-- plugin name="${prefix}thinker_TF1_joint_states_plugin"
		        filename="libthinker_gazebo_model_plugin.so" -->
  <!-- please comment it out to enable default namespace -->
  <!-- robotNamespace></robotNamespace -->
  <!-- rosDebugLevel>Info</rosDebugLevel -->
  <!-- jointStateFrequency>${frequency}</jointStateFrequency -->
  <!-- jointStateTopicName>sensor/gazebo_states</jointStateTopicName -->
  <!-- jointEffortTopicName>command/gazebo_effort</jointEffortTopicName -->
  <!-- /plugin -->
  <!-- /gazebo -->
  <ros2_control name="robotiq_hande_gripper" type="system">
    <hardware>
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>
    <!-- The right finger joint uses the mimic feature -->
    <joint name="robotiq_hande_left_finger_joint">
      <command_interface name="position">
        <param name="min">0</param>
        <param name="max">0.025</param>
      </command_interface>
      <state_interface name="position">
        <param name="initial_value">0.025</param>
      </state_interface>
      <state_interface name="velocity">
        <param name="initial_value">0</param>
      </state_interface>
    </joint>
  </ros2_control>
  <!-- Robotiq Hand-E specs -->
  <!--  + Height added by the IO coupler: 11.0mm -->
  <!--  + Height added by the Hand-E: 99.0mm -->
  <!--  + Coupler mass includes the bolts -->
  <joint name="robotiq_hande_coupler_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="thinker_THF1_base_link"/>
    <child link="robotiq_hande_coupler"/>
  </joint>
  <link name="robotiq_hande_coupler">
    <visual>
      <!-- original transform -->
      <!-- origin xyz="0 0 0" rpy="0 0 0"/ -->
      <!-- Thinker's transform -->
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://robotiq_hande_description/meshes/io_coupler.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.005449999999999999"/>
      <geometry>
        <cylinder length="0.0169" radius="0.0385"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.119"/>
      <origin rpy="0 0 0" xyz="0 0 0.005449999999999999"/>
      <inertia ixx="4.4668218799372e-05" ixy="0.0" ixz="0.0" iyy="4.4668218799372e-05" iyz="0.0" izz="8.367187499999999e-05"/>
    </inertial>
  </link>
  <joint name="robotiq_hande_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.011"/>
    <parent link="robotiq_hande_coupler"/>
    <child link="robotiq_hande_link"/>
  </joint>
  <link name="robotiq_hande_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://robotiq_hande_description/meshes/hande.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.053450000000000004"/>
      <geometry>
        <cylinder length="0.10690000000000001" radius="0.0385"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.86387"/>
      <origin rpy="0 0 0" xyz="0 0 0.0495"/>
      <inertia ixx="0.0010092697156669523" ixy="0.0" ixz="0.0" iyy="0.0010092697156669523" iyz="0.0" izz="0.00060740859375"/>
    </inertial>
  </link>
  <joint name="robotiq_hande_left_finger_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0 0 0.099"/>
    <parent link="robotiq_hande_link"/>
    <child link="robotiq_hande_left_finger"/>
    <axis xyz="1 0 0"/>
    <limit effort="130" lower="0.00175" upper="0.025" velocity="0.15"/>
  </joint>
  <link name="robotiq_hande_left_finger">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://thinker_ros2_description/grippers/robotiq-hande/meshes/visual/finger-slider.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <!-- *************************************************** -->
    <!-- *************************************************** -->
    <!-- collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://thinker_ros2_description/grippers/robotiq-hande/meshes/collision/finger-slider.dae" scale="1.0 1.0 1.0"/>
        </geometry>
      </collision -->
    <!-- *************************************************** -->
    <!-- *************************************************** -->
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.03804"/>
      <inertia ixx="1E-9" ixy="0.0" ixz="0.0" iyy="1E-9" iyz="0.0" izz="1E-9"/>
    </inertial>
  </link>
  <joint name="robotiq_hande_right_finger_joint" type="prismatic">
    <origin rpy="0 0 0" xyz="0 0 0.099"/>
    <parent link="robotiq_hande_link"/>
    <child link="robotiq_hande_right_finger"/>
    <axis xyz="-1 0 0"/>
    <limit effort="130" lower="0.00175" upper="0.025" velocity="0.15"/>
    <mimic joint="robotiq_hande_left_finger_joint" multiplier="1" offset="0"/>
  </joint>
  <link name="robotiq_hande_right_finger">
    <visual>
      <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://thinker_ros2_description/grippers/robotiq-hande/meshes/visual/finger-slider.dae" scale="1.0 1.0 1.0"/>
      </geometry>
    </visual>
    <!-- *************************************************** -->
    <!-- *************************************************** -->
    <!-- collision>
        <origin xyz="0 0 0" rpy="0 0 ${pi}"/>
        <geometry>
          <mesh filename="package://thinker_ros2_description/grippers/robotiq-hande/meshes/collision/finger-slider.dae" scale="1.0 1.0 1.0"/>
        </geometry>
      </collision -->
    <!-- *************************************************** -->
    <!-- *************************************************** -->
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.03804"/>
      <inertia ixx="1E-9" ixy="0.0" ixz="0.0" iyy="1E-9" iyz="0.0" izz="1E-9"/>
    </inertial>
  </link>
  <joint name="robotiq_hande_end_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.14550000000000002"/>
    <parent link="robotiq_hande_link"/>
    <child link="robotiq_hande_end"/>
  </joint>
  <link name="robotiq_hande_end"/>
  <!-- ***************************** -->
  <!-- add fixed joints to put items -->
  <!-- ***************************** -->
  <joint name="thinker_THF1_base_joint" type="fixed">
    <parent link="thinker_arm_tool0"/>
    <child link="thinker_THF1_base_link"/>
    <origin rpy="0 0 0" xyz="0 0 0"/>
  </joint>
  <joint name="thinker_THF1_paw_joint" type="fixed">
    <parent link="robotiq_hande_link"/>
    <child link="thinker_THF1_paw_link"/>
    <origin rpy="0 0 1.5707963267948966" xyz="0 0 0.10010000000000001"/>
  </joint>
  <!-- ******************************** -->
  <!-- fictive links to ease definition -->
  <!-- ******************************** -->
  <!-- ******************************************** -->
  <!-- fictive link                                 -->
  <!-- to be simple, inertia model is 1g sphere,    -->
  <!-- with radius 0.016m, density 58kg/m3,         -->
  <!-- and visual model is 1cm-width box.           -->
  <!-- if principal inertia is less than 1e-7kg*m2, -->
  <!-- gazebo simulator would have ill result.      -->
  <!-- ******************************************** -->
  <link name="f1_thinker_TF1_tip_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1.0e-7" ixy="0" ixz="0" iyy="1.0e-7" iyz="0" izz="1.0e-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <material name="f1_thinker_TF1_tip_link_color">
        <color rgba="0.1 0.1 0.9 1.0"/>
      </material>
    </visual>
  </link>
  <!-- ************** -->
  <!-- links of robot -->
  <!-- ************** -->
  <link name="f1_thinker_TF1_nail_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.007 0.015"/>
      <mass value="0.01"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://thinker_ros2_description/nails/thinker-TF1/meshes/visual/default-nail.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://thinker_ros2_description/nails/thinker-TF1/meshes/collision/default-nail.dae"/>
      </geometry>
    </collision>
  </link>
  <!-- ***************** -->
  <!-- fixed link offset -->
  <!-- ***************** -->
  <joint name="f1_thinker_TF1_nail_joint" type="fixed">
    <parent link="f1_thinker_TF1_nail_mount_link"/>
    <child link="f1_thinker_TF1_nail_link"/>
    <origin rpy="0 0 0" xyz="0 0.0015 0"/>
  </joint>
  <joint name="f1_thinker_TF1_tip_joint" type="fixed">
    <parent link="f1_thinker_TF1_nail_link"/>
    <child link="f1_thinker_TF1_tip_link"/>
    <origin rpy="0 0 0.0" xyz="0 0.0153 0.034"/>
  </joint>
  <!-- ******************************** -->
  <!-- fictive links to ease definition -->
  <!-- ******************************** -->
  <!-- ******************************************** -->
  <!-- fictive link                                 -->
  <!-- to be simple, inertia model is 1g sphere,    -->
  <!-- with radius 0.016m, density 58kg/m3,         -->
  <!-- and visual model is 1cm-width box.           -->
  <!-- if principal inertia is less than 1e-7kg*m2, -->
  <!-- gazebo simulator would have ill result.      -->
  <!-- ******************************************** -->
  <link name="f2_thinker_TF1_tip_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1.0e-7" ixy="0" ixz="0" iyy="1.0e-7" iyz="0" izz="1.0e-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.001 0.001 0.001"/>
      </geometry>
      <material name="f2_thinker_TF1_tip_link_color">
        <color rgba="0.1 0.1 0.9 1.0"/>
      </material>
    </visual>
  </link>
  <!-- ************** -->
  <!-- links of robot -->
  <!-- ************** -->
  <link name="f2_thinker_TF1_nail_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0.007 0.015"/>
      <mass value="0.01"/>
      <inertia ixx="1e-7" ixy="0" ixz="0" iyy="1e-7" iyz="0" izz="1e-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://thinker_ros2_description/nails/thinker-TF1/meshes/visual/default-nail.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://thinker_ros2_description/nails/thinker-TF1/meshes/collision/default-nail.dae"/>
      </geometry>
    </collision>
  </link>
  <!-- ***************** -->
  <!-- fixed link offset -->
  <!-- ***************** -->
  <joint name="f2_thinker_TF1_nail_joint" type="fixed">
    <parent link="f2_thinker_TF1_nail_mount_link"/>
    <child link="f2_thinker_TF1_nail_link"/>
    <origin rpy="0 0 3.141592653589793" xyz="0 -0.0015 0"/>
  </joint>
  <joint name="f2_thinker_TF1_tip_joint" type="fixed">
    <parent link="f2_thinker_TF1_nail_link"/>
    <child link="f2_thinker_TF1_tip_link"/>
    <origin rpy="0 0 -3.141592653589793" xyz="0 0.0153 0.034"/>
  </joint>
  <!-- ***************************** -->
  <!-- add fixed joints to put items -->
  <!-- ***************************** -->
  <joint name="robotiq_thinker_tool_joint" type="fixed">
    <parent link="thinker_THF1_paw_link"/>
    <child link="thinker_THF1_tool_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.1039"/>
  </joint>
  <!-- camera body, with origin at bottom screw mount -->
  <joint name="thinker_camera_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="realsense_mount_link"/>
    <child link="thinker_camera_bottom_screw_frame"/>
  </joint>
  <link name="thinker_camera_bottom_screw_frame"/>
  <joint name="thinker_camera_link_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.01085 0.009 0.021"/>
    <parent link="thinker_camera_bottom_screw_frame"/>
    <child link="thinker_camera_link"/>
  </joint>
  <link name="thinker_camera_link">
    <visual>
      <!-- the mesh origin is at front plate in between the two infrared camera axes -->
      <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0.0038 -0.009 0"/>
      <geometry>
        <mesh filename="package://realsense2_description/meshes/d405.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="aluminum"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="-0.0078 -0.009 0"/>
      <geometry>
        <box size="0.023 0.042 0.042"/>
      </geometry>
    </collision>
    <inertial>
      <!-- The following are not reliable values, and should not be used for modeling -->
      <mass value="0.072"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.003881243" ixy="0.0" ixz="0.0" iyy="0.000498940" iyz="0.0" izz="0.003879257"/>
    </inertial>
  </link>
  <!-- links -  main serial chain -->
  <!-- base_link serves as the root of the robot's kinematic tree. It follows REP-103
        conventions (i.e., X+ forward, Y+ left, Z+ up).
        Since some kinematic solvers forbid having inertia values attached to a root link, we've
        added the base_link_inertia link that carries the visual, collision and inertia
        information.
    -->
  <link name="thinker_arm_base_link"/>
  <link name="thinker_arm_base_link_inertia">
    <visual>
      <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3e/visual/base.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3e/collision/base.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <inertia ixx="0.0030531654454" ixy="0.0" ixz="0.0" iyy="0.0030531654454" iyz="0.0" izz="0.005625"/>
    </inertial>
  </link>
  <link name="thinker_arm_shoulder_link">
    <visual>
      <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3e/visual/shoulder.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 3.141592653589793" xyz="0.0 0.0 0.0"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3e/collision/shoulder.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.98"/>
      <origin rpy="1.570796326794897 0 0" xyz="0.0 0.0 -0.02"/>
      <inertia ixx="0.0027657" ixy="9.6e-06" ixz="-1.49e-05" iyy="0.0021501" iyz="0.0001873" izz="0.0025626"/>
    </inertial>
  </link>
  <link name="thinker_arm_upper_arm_link">
    <visual>
      <origin rpy="1.5707963267948966 0.0 -1.5707963267948966" xyz="0.0 0.0 0.12"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3e/visual/upperarm.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0.0 -1.5707963267948966" xyz="0.0 0.0 0.12"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3e/collision/upperarm.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="3.4445"/>
      <origin rpy="0 0 0" xyz="-0.11355 0.0 0.1157"/>
      <inertia ixx="0.0042623" ixy="-4.09e-05" ixz="-0.001496" iyy="0.0460284" iyz="-1.29e-05" izz="0.0448947"/>
    </inertial>
  </link>
  <link name="thinker_arm_forearm_link">
    <visual>
      <origin rpy="1.5707963267948966 0.0 -1.5707963267948966" xyz="0.0 0.0 0.027"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3e/visual/forearm.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0.0 -1.5707963267948966" xyz="0.0 0.0 0.027"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3e/collision/forearm.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="1.437"/>
      <origin rpy="0 0 0" xyz="-0.1632 0.0 0.0238"/>
      <inertia ixx="0.0010511" ixy="0.0" ixz="-3.31e-05" iyy="0.0113396" iyz="2.2e-06" izz="0.0110895"/>
    </inertial>
  </link>
  <link name="thinker_arm_wrist_1_link">
    <visual>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.104"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3e/visual/wrist1.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.104"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3e/collision/wrist1.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.871"/>
      <origin rpy="1.570796326794897 0 0" xyz="0.0 -0.01 0.0"/>
      <inertia ixx="0.0008174" ixy="-5e-07" ixz="2.1e-06" iyy="0.0006844" iyz="6.17e-05" izz="0.0005497"/>
    </inertial>
  </link>
  <link name="thinker_arm_wrist_2_link">
    <visual>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.08535"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3e/visual/wrist2.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 -0.08535"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3e/collision/wrist2.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.805"/>
      <origin rpy="-1.570796326794897 0 0" xyz="0.0 0.01 0.0"/>
      <inertia ixx="0.0006059" ixy="-6e-07" ixz="-6e-07" iyy="0.0005837" iyz="-2.71e-05" izz="0.0003831"/>
    </inertial>
  </link>
  <link name="thinker_arm_wrist_3_link">
    <visual>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.0921"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3e/visual/wrist3.dae"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.5707963267948966 0.0 0.0" xyz="0.0 0.0 -0.0921"/>
      <geometry>
        <mesh filename="package://ur_description/meshes/ur3e/collision/wrist3.stl"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.261"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 -0.02"/>
      <inertia ixx="0.000108" ixy="-1e-07" ixz="-1e-07" iyy="0.0001086" iyz="-2e-07" izz="0.0001371"/>
    </inertial>
  </link>
  <!-- base_joint fixes base_link to the environment -->
  <joint name="thinker_arm_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="base_link"/>
    <child link="thinker_arm_base_link"/>
  </joint>
  <!-- joints - main serial chain -->
  <joint name="thinker_arm_base_link-base_link_inertia" type="fixed">
    <parent link="thinker_arm_base_link"/>
    <child link="thinker_arm_base_link_inertia"/>
    <!-- 'base_link' is REP-103 aligned (so X+ forward), while the internal
           frames of the robot/controller have X+ pointing backwards.
           Use the joint between 'base_link' and 'base_link_inertia' (a dummy
           link/frame) to introduce the necessary rotation over Z (of pi rad).
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
  </joint>
  <joint name="thinker_arm_shoulder_pan_joint" type="revolute">
    <parent link="thinker_arm_base_link_inertia"/>
    <child link="thinker_arm_shoulder_link"/>
    <origin rpy="0 0 0" xyz="0 0 0.15185"/>
    <axis xyz="0 0 1"/>
    <limit effort="54.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="thinker_arm_shoulder_lift_joint" type="revolute">
    <parent link="thinker_arm_shoulder_link"/>
    <child link="thinker_arm_upper_arm_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="54.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="thinker_arm_elbow_joint" type="revolute">
    <parent link="thinker_arm_upper_arm_link"/>
    <child link="thinker_arm_forearm_link"/>
    <origin rpy="0 0 0" xyz="-0.24355 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="28.0" lower="-3.141592653589793" upper="3.141592653589793" velocity="3.141592653589793"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="thinker_arm_wrist_1_joint" type="revolute">
    <parent link="thinker_arm_forearm_link"/>
    <child link="thinker_arm_wrist_1_link"/>
    <origin rpy="0 0 0" xyz="-0.2132 0 0.13105"/>
    <axis xyz="0 0 1"/>
    <limit effort="9.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="6.283185307179586"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="thinker_arm_wrist_2_joint" type="revolute">
    <parent link="thinker_arm_wrist_1_link"/>
    <child link="thinker_arm_wrist_2_link"/>
    <origin rpy="1.570796327 0 0" xyz="0 -0.08535 -1.750557762378351e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="9.0" lower="-6.283185307179586" upper="6.283185307179586" velocity="6.283185307179586"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <joint name="thinker_arm_wrist_3_joint" type="continuous">
    <parent link="thinker_arm_wrist_2_link"/>
    <child link="thinker_arm_wrist_3_link"/>
    <origin rpy="1.570796326589793 3.141592653589793 3.141592653589793" xyz="0 0.0921 -1.8890025766262e-11"/>
    <axis xyz="0 0 1"/>
    <limit effort="9.0" velocity="6.283185307179586"/>
    <dynamics damping="0" friction="0"/>
  </joint>
  <link name="thinker_arm_ft_frame"/>
  <joint name="thinker_arm_wrist_3_link-ft_frame" type="fixed">
    <parent link="thinker_arm_wrist_3_link"/>
    <child link="thinker_arm_ft_frame"/>
    <origin rpy="3.141592653589793 0 0" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'base' frame - base_link to UR 'Base' Coordinates transform -->
  <link name="thinker_arm_base"/>
  <joint name="thinker_arm_base_link-base_fixed_joint" type="fixed">
    <!-- Note the rotation over Z of pi radians - as base_link is REP-103
           aligned (i.e., has X+ forward, Y+ left and Z+ up), this is needed
           to correctly align 'base' with the 'Base' coordinate system of
           the UR controller.
      -->
    <origin rpy="0 0 3.141592653589793" xyz="0 0 0"/>
    <parent link="thinker_arm_base_link"/>
    <child link="thinker_arm_base"/>
  </joint>
  <!-- ROS-Industrial 'flange' frame - attachment point for EEF models -->
  <link name="thinker_arm_flange"/>
  <joint name="thinker_arm_wrist_3-flange" type="fixed">
    <parent link="thinker_arm_wrist_3_link"/>
    <child link="thinker_arm_flange"/>
    <origin rpy="0 -1.5707963267948966 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <!-- ROS-Industrial 'tool0' frame - all-zeros tool frame -->
  <link name="thinker_arm_tool0"/>
  <joint name="thinker_arm_flange-tool0" type="fixed">
    <!-- default toolframe - X+ left, Y+ up, Z+ front -->
    <origin rpy="1.5707963267948966 0 1.5707963267948966" xyz="0 0 0"/>
    <parent link="thinker_arm_flange"/>
    <child link="thinker_arm_tool0"/>
  </joint>
  <!-- ***************************** -->
  <!-- add fixed joints to put items -->
  <!-- ***************************** -->
  <joint name="realsense_mount_joint" type="fixed">
    <parent link="thinker_THF1_base_link"/>
    <child link="realsense_mount_link"/>
    <origin rpy="0 -1.5707963267948966 1.5707963267948966" xyz="0 -0.040 0.110"/>
  </joint>
</robot>
