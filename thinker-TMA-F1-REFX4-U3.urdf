  <link name="f1_thinker_TF1_base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 -0.01 0.064"/>
      <mass value="0.285"/>
      <inertia ixx="1.5e-4" ixy="0" ixz="0" iyy="1.1e-4" iyz="0" izz="0.86e-4"/>
