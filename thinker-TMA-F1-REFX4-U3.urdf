    <child link="f1_thinker_TF1_x_link"/>
    <origin rpy="-1.5707963267948966 0 0" xyz="0 0 0.0373"/>
    <axis xyz="0 0 1"/>
    <limit effort="20.0" lower="-0.17453292519943295" upper="0.17453292519943295" velocity="2.00"/>
    <!-- safety_controller narrows range to control with joint_state_publisher -->
    <!-- safety_controller soft_lower_limit="${-PI/180*(x_stroke - 0.5)}" soft_upper_limit="${PI/180*(x_stroke - 0.5)}"
		                   k_position="22.9" k_velocity="800" / -->
    <dynamics damping="0.001"/>
  </joint>
  <joint name="f1_thinker_TF1_y_joint" type="revolute">
    <parent link="f1_thinker_TF1_x_link"/>
    <child link="f1_thinker_TF1_y_link"/>
    <origin rpy="0 1.5707963267948966 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="20.0" lower="-0.17453292519943295" upper="0.17453292519943295" velocity="6.28"/>
    <!-- safety_controller narrows range to control with joint_state_publisher -->
    <!-- safety_controller soft_lower_limit="${-PI/180*(y_stroke - 0.5)}" soft_upper_limit="${PI/180*(y_stroke - 0.5)}"
		                   k_position="72.0" k_velocity="800" / -->
    <dynamics damping="0.001"/>
  </joint>
  <joint name="f1_thinker_TF1_z_joint" type="prismatic">
    <parent link="f1_thinker_TF1_y_link"/>
    <child link="f1_thinker_TF1_z_link"/>
    <origin rpy="1.5707963267948966 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="1000.0" lower="0.0" upper="0.005" velocity="10.0"/>
    <!-- safety_controller narrows range to control with joint_state_publisher -->
    <!-- safety_controller soft_lower_limit="0.0002" soft_upper_limit="${z_stroke - 0.0002}"
		                   k_position="100.0" k_velocity="1000" / -->
    <dynamics damping="0.001"/>
  </joint>
  <!-- ********************** -->
  <!-- transmissions of robot -->
  <!-- ********************** -->
  <transmission name="f1_thinker_TF1_x_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="f1_thinker_TF1_x_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="f1_thinker_TF1_x_motor">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>hardware_interface/EffortActuatorInterface</hardwareInterface>
    </actuator>
  </transmission>
  <transmission name="f1_thinker_TF1_y_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="f1_thinker_TF1_y_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="f1_thinker_TF1_y_motor">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>hardware_interface/EffortActuatorInterface</hardwareInterface>
    </actuator>
  </transmission>
  <transmission name="f1_thinker_TF1_z_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="f1_thinker_TF1_z_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="f1_thinker_TF1_z_motor">
      <mechanicalReduction>1</mechanicalReduction>
      <hardwareInterface>hardware_interface/EffortActuatorInterface</hardwareInterface>
    </actuator>
  </transmission>
  <!-- *************************** -->
  <!-- gazebo parameters for robot -->
  <!-- *************************** -->
  <gazebo reference="f1_thinker_TF1_base_link">
    <mu1>1</mu1>
    <mu2>1</mu2>
    <kp>1e+6</kp>
    <kd>1</kd>
    <maxContacts>20</maxContacts>
  </gazebo>
  <!-- *************************** -->
  <!-- gazebo ROS interface plugin -->
  <!-- *************************** -->
  <!-- gazebo -->
  <!-- plugin name="${prefix}thinker_TF1_joint_states_plugin"
		        filename="libthinker_gazebo_model_plugin.so" -->
  <!-- please comment it out to enable default namespace -->
  <!-- robotNamespace></robotNamespace -->
  <!-- rosDebugLevel>Info</rosDebugLevel -->
  <!-- jointStateFrequency>${frequency}</jointStateFrequency -->
  <!-- jointStateTopicName>sensor/gazebo_states</jointStateTopicName -->
  <!-- jointEffortTopicName>command/gazebo_effort</jointEffortTopicName -->
  <!-- /plugin -->
  <!-- /gazebo -->
  <!-- ************* -->
  <!-- include files -->
  <!-- ************* -->
  <!-- *********************************************************** -->
  <!--  @brief    Thinker ROS2 Description Common URDF             -->
  <!--  @author   SAIDA Takao, Thinker Inc.                        -->
  <!--  @par      Copyright:                                       -->
  <!--            2026, Thinker Inc.                               -->
  <!--  @par      License: see LICENSE                             -->
  <!--  @file     thinker/ros2/description/urdf/common_urdf.xacro  -->
